{
  "name": "Tennis Oracle",
  "install": "bash .cursor/install.sh",
  "start": "bash .cursor/start.sh",
  "terminals": [
    {
      "name": "backend-api",
      "command": "PYTHONPATH=. backend/.venv/bin/uvicorn backend.src.app.main:app --host 0.0.0.0 --port 8000"
    },
    {
      "name": "frontend-dev",
      "command": "cd frontend && npm run dev -- --host 0.0.0.0 --port 5173"
    }
  ],
  "ports": [8000, 5173]
}
