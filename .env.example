# Docker Compose overrides (ports + DB host seen from containers).
# Copy to `.env` at the repository root.
# Staging: use `.env.staging.example` → `.env.staging` + docs/STAGING.md
#   (separate DB volume, ports 8001/5174/5433, AUTO_MIGRATE, staging bot).
# Credenziali: backend/.env e backend/properties/config.env (montati).
# NEVER commit real secrets.

# --- Compose / images ---
IMAGE_TAG=local
APP_ENV=local
DEBUG=false

# --- Host PostgreSQL (default). Same DB as local non-Docker runs. ---
# From containers use host.docker.internal (not localhost).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=tennis_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@host.docker.internal:5432/tennis_db
DATABASE_SOURCE_URL=postgresql://postgres:postgres@host.docker.internal:5432/tennis_db

# Embedded db-1 is OFF by default (Compose profile: embedded-db). Volume is kept.
# To use db-1 later: DATABASE_URL=postgresql://postgres:postgres@db:5432/tennis_db
#   docker compose --profile embedded-db up -d db

# --- Published ports (UI 5173, API 8000) ---
API_PORT=8000
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8000

# CORS: JSON list of allowed SPA origins. Empty CORS_ORIGIN_REGEX disables regex matching.
CORS_ORIGINS=["http://localhost:5173","http://localhost:5174","http://127.0.0.1:5173","http://127.0.0.1:5174"]
CORS_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1):\d+$

ADMIN_JWT_SECRET=local-dev-jwt-secret-change-in-production
ADMIN_JWT_EXPIRE_MINUTES=480
ADMIN_USERNAME=admin
ADMIN_PASSWORD=1234

SERVICE_API_KEY=
SERVICE_API_KEY_PREVIOUS=
ALLOW_UNAUTHENTICATED_SERVICE_READS=true

RATE_LIMIT_ENABLED=true
# Prefer external job (compose profile jobs / host cron). Keep in-app cron off in prod.
GLOBAL_UPDATE_CRON_ENABLED=false
GLOBAL_UPDATE_STEP_RETRIES=2
GLOBAL_UPDATE_RETRY_BACKOFF_SECONDS=5
GLOBAL_UPDATE_STEP_TIMEOUT_SECONDS=3600
GLOBAL_UPDATE_LOCK_TTL_SECONDS=21600

MODELS_HOST_PATH=./backend/data/models

DATABASE_TARGET_URL=
SYNC_CLOUD=false

# --- Observability (docs/MONITORING.md) ---
LOG_FORMAT=text
METRICS_PROVIDER=memory
METRICS_ENDPOINT_ENABLED=true
ERROR_TRACKING_PROVIDER=none
ERROR_TRACKING_DSN=
ERROR_TRACKING_WEBHOOK_URL=
OPS_ALERTS_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
OPS_ALERT_WEBHOOK_URL=
OPS_ALERT_COOLDOWN_SECONDS=300
OPS_IMPORT_MAX_AGE_HOURS=36
OPS_PREDICTIONS_LOOKBACK_HOURS=36
OPS_PIPELINE_MAX_DURATION_SECONDS=7200

# --- PostgreSQL backup / DR (docs/BACKUP_DR.md) ---
# Passwords stay in DATABASE_URL / POSTGRES_PASSWORD — never in scripts.
BACKUP_DIR=backups
BACKUP_RETENTION_DAYS=7
BACKUP_ENCRYPT=false
BACKUP_GPG_RECIPIENT=
BACKUP_GPG_PASSPHRASE_FILE=
