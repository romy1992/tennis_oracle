# Docker Compose overrides (ports + DB host seen from containers).
# Copy to `.env` at the repository root.
# Staging: use `.env.staging.example` → `.env.staging` + docs/STAGING.md
#   (separate DB volume, ports 8001/5174/5433, AUTO_MIGRATE, staging bot).
# Segreti runtime: backend/.env (modello: backend/.env.example).
# backend/properties/config.env resta fallback non sensibile.
# NEVER commit real secrets.

# --- Compose / images ---
IMAGE_TAG=local
APP_ENV=local
DEBUG=false

# --- Host PostgreSQL (default). Same DB as local non-Docker runs. ---
# From containers use host.docker.internal (not localhost).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=tennis_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@host.docker.internal:5432/tennis_db
DATABASE_SOURCE_URL=postgresql://postgres:postgres@host.docker.internal:5432/tennis_db

# Embedded db-1 is OFF by default (Compose profile: embedded-db). Volume is kept.
# To use db-1 later: DATABASE_URL=postgresql://postgres:postgres@db:5432/tennis_db
#   docker compose --profile embedded-db up -d db

# --- Published ports (UI 5173, API 8000) ---
API_PORT=8000
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8000

# CORS: JSON list of allowed SPA origins. Empty CORS_ORIGIN_REGEX disables regex matching.
CORS_ORIGINS=["http://localhost:5173","http://localhost:5174","http://127.0.0.1:5173","http://127.0.0.1:5174"]
CORS_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1):\d+$

ADMIN_JWT_SECRET=local-dev-jwt-secret-change-in-production
ADMIN_JWT_EXPIRE_MINUTES=480
ADMIN_USERNAME=admin
ADMIN_PASSWORD=1234

SERVICE_API_KEY=
SERVICE_API_KEY_PREVIOUS=
ALLOW_UNAUTHENTICATED_SERVICE_READS=true

# --- Payments (provider abstraction + first provider: Stripe) ---
PAYMENTS_PROVIDER=stripe
PAYMENTS_MODE=sandbox
PAYMENTS_SUCCESS_URL=http://localhost:5173/payments/success
PAYMENTS_CANCEL_URL=http://localhost:5173/payments/cancel
PAYMENTS_PORTAL_RETURN_URL=http://localhost:5173/account
PAYMENTS_PORTAL_LINK_TTL_SECONDS=1800
PAYMENTS_IDEMPOTENCY_BUCKET_SECONDS=900
STRIPE_API_BASE=https://api.stripe.com/v1
STRIPE_REQUEST_TIMEOUT_SECONDS=20
STRIPE_SECRET_KEY=sk_test_change_me
STRIPE_WEBHOOK_SECRET=whsec_change_me
STRIPE_PRICE_MONTHLY=price_change_me_monthly
STRIPE_PRICE_YEARLY=price_change_me_yearly
STRIPE_WEBHOOK_TOLERANCE_SECONDS=300

RATE_LIMIT_ENABLED=true
# Prefer external job (compose profile jobs / host cron). Keep in-app cron off in prod.
GLOBAL_UPDATE_CRON_ENABLED=false
GLOBAL_UPDATE_STEP_RETRIES=2
GLOBAL_UPDATE_RETRY_BACKOFF_SECONDS=5
GLOBAL_UPDATE_STEP_TIMEOUT_SECONDS=3600
GLOBAL_UPDATE_LOCK_TTL_SECONDS=21600

# --- Scheduled operational reports (dedicated Compose service) ---
# Enable only after RESEND_API_KEY is injected by the deployment secret store.
SCHEDULED_REPORTS_ENABLED=false
SCHEDULED_REPORTS_TIMEZONE=Europe/Rome
SCHEDULED_GLOBAL_UPDATE_TIME=08:00
# datetime.weekday: Monday=0 ... Sunday=6
SCHEDULED_WEEKLY_VALIDATION_DAY=0
SCHEDULED_WEEKLY_VALIDATION_TIME=10:00
SCHEDULED_REPORTS_POLL_SECONDS=30
SCHEDULED_REPORTS_RECOVERY_SECONDS=5400
SCHEDULED_JOB_SOURCE_NAME=tennis-oracle-local
SCHEDULED_JOB_SOURCE_URL=http://localhost:8000
SCHEDULED_JOB_SOURCE_PATH=/app
# TODO production: use SCHEDULED_JOB_SOURCE_NAME=tennis-oracle-prod and set its public URL.

# Daily + weekly report delivery. RESEND_API_KEY must remain a runtime secret.
REPORT_EMAIL_ENABLED=false
REPORT_EMAIL_TO=trottarosario@gmail.com
RESEND_API_KEY=
RESEND_API_BASE=https://api.resend.com
# onboarding@resend.dev is DEV-only and can send only to the Resend account email.
RESEND_FROM="Tennis Oracle <onboarding@resend.dev>"
RESEND_TIMEOUT_SECONDS=20

MODELS_HOST_PATH=./backend/data/models
# Training CSV datasets (walk-forward / train_baseline). Required inside Docker API/job.
PROCESSED_HOST_PATH=./backend/data/processed
# Metrics / walk-forward JSON reports (writable from container).
REPORTS_HOST_PATH=./backend/data/reports

DATABASE_TARGET_URL=
SYNC_CLOUD=false

# --- Observability (docs/MONITORING.md) ---
LOG_FORMAT=text
METRICS_PROVIDER=memory
METRICS_ENDPOINT_ENABLED=true
ERROR_TRACKING_PROVIDER=none
ERROR_TRACKING_DSN=
ERROR_TRACKING_WEBHOOK_URL=
OPS_ALERTS_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
# Beta users (API + bot). Never commit real tokens.
TELEGRAM_WHITELIST_ENABLED=true
TELEGRAM_TERMS_REQUIRED=false
TELEGRAM_TERMS_VERSION=1
# Optional public URL shown when a premium command is denied (no secrets).
TELEGRAM_PREMIUM_UPGRADE_URL=
# Optional public URL shown in bot footers (feedback / segnalazioni).
TELEGRAM_FEEDBACK_URL=
# User push notifications (job run_telegram_notifications). Default off.
# Admin pipeline alerts use OPS_ALERTS_* + TELEGRAM_ADMIN_CHAT_ID separately.
TELEGRAM_NOTIFICATIONS_ENABLED=true
TELEGRAM_NOTIFY_PREDICTIONS_ENABLED=true
TELEGRAM_NOTIFY_RESULTS_ENABLED=true
TELEGRAM_NOTIFY_EMPTY_DAY_ENABLED=true
TELEGRAM_NOTIFY_MIN_INTERVAL_SECONDS=0.05
TELEGRAM_NOTIFY_MAX_RETRIES=2
TELEGRAM_NOTIFY_RETRY_BACKOFF_SECONDS=2.0
BETTING_SLIP_TIMEZONE=Europe/Rome
BETTING_SLIP_POOL_CLOSE_TIME=10:00
BETTING_SLIP_LIVE_POLL_ENABLED=false
BETTING_SLIP_LIVE_POLL_INTERVAL_SECONDS=180
BETTING_SLIP_RECAP_ENABLED=false
BETTING_SLIP_RECAP_TIME=23:30
BETTING_SLIP_RECAP_STAKE=10.0
# Weekly beta report admin Telegram summary (independent of OPS_ALERTS_ENABLED).
WEEKLY_BETA_REPORT_TELEGRAM_ENABLED=true
# Walk-forward validation (separate from live KPIs / public model).
WALK_FORWARD_IN_GLOBAL_UPDATE=false
WALK_FORWARD_MODE=expanding
WALK_FORWARD_INITIAL_TRAIN_DAYS=365
WALK_FORWARD_TEST_DAYS=90
WALK_FORWARD_STEP_DAYS=90
WALK_FORWARD_MIN_TRAIN_ROWS=200
WALK_FORWARD_MIN_TEST_ROWS=50
WALK_FORWARD_EMBARGO_DAYS=0
WALK_FORWARD_EDGE_THRESHOLD=0.03
WALK_FORWARD_RANDOM_STATE=42
CALIBRATION_N_BINS=10
CALIBRATION_MIN_BIN_SAMPLES=30
CALIBRATION_MIN_CALIBRATOR_TRAIN_SAMPLES=100
OPS_ALERT_WEBHOOK_URL=
OPS_ALERT_COOLDOWN_SECONDS=300
OPS_IMPORT_MAX_AGE_HOURS=36
OPS_PREDICTIONS_LOOKBACK_HOURS=36
OPS_PIPELINE_MAX_DURATION_SECONDS=7200

# --- PostgreSQL backup / DR (docs/BACKUP_DR.md) ---
# Passwords stay in DATABASE_URL / POSTGRES_PASSWORD — never in scripts.
BACKUP_DIR=backups
BACKUP_RETENTION_DAYS=7
BACKUP_ENCRYPT=false
BACKUP_GPG_RECIPIENT=
BACKUP_GPG_PASSPHRASE_FILE=
