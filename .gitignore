# git ls-files --others --exclude-from=.git/info/exclude
# Lines that start with '#' are comments.
# For a project mostly in C, the following would be a good set of
# exclude patterns (uncomment them if you want to use them):
# *.[oa]
# *~
/.idea
*.pyc
/logs/
/backend/.env
/frontend/.env
/frontend/dist/
/frontend/node_modules/
/backend/data/processed/*.csv
/.venv/
/venv/
/backend/.venv/
/backend/venv/
/backend/src/back_up_db/

# Frontend
frontend/node_modules/
node_modules/

# Dataset generati
backend/data/processed/

# Modelli addestrati
backend/data/models/

# Backup database
backups/
*.sql

# Log
*.log
debug-*.log

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Variabili locali
.env
.env.*
!.env.example