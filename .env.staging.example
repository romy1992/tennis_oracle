# Staging environment template for tennis_oracle.
# Copy to `.env.staging` (never commit real secrets):
#   cp .env.staging.example .env.staging
#
# Start:
#   docker compose -f docker-compose.yml -f docker-compose.staging.yml --env-file .env.staging up --build -d
#
# See docs/STAGING.md for deploy / rollback checklist.

# --- Compose / images ---
IMAGE_TAG=staging
APP_ENV=staging
DEBUG=false

# --- Separate staging database (Compose service `db`, own volume) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-staging-db-password
POSTGRES_DB=tennis_db_staging
STAGING_POSTGRES_PORT=5433
DATABASE_URL=postgresql://postgres:change-me-staging-db-password@db:5432/tennis_db_staging
DATABASE_SOURCE_URL=postgresql://postgres:change-me-staging-db-password@db:5432/tennis_db_staging

# External managed Postgres (optional): point DATABASE_* at the provider URL and
# do not start embedded db — see docs/STAGING.md.

# --- Controlled migrations (migrate service) ---
# true  = alembic upgrade head before API starts (default)
# false = skip schema changes (freeze / rollback without migrate)
AUTO_MIGRATE=true

# --- Published ports (avoid clash with local 8000 / 5173 / 5432) ---
STAGING_API_PORT=8001
STAGING_FRONTEND_PORT=5174
# Browser-facing API URL (baked into the SPA at build time).
# Behind HTTPS reverse proxy use https://staging-api.example.com (no trailing slash).
VITE_API_BASE_URL=http://localhost:8001

# --- CORS (HTTPS-ready: list exact SPA origins; leave regex empty if unused) ---
CORS_ORIGINS=["https://staging.example.com","http://localhost:5174"]
CORS_ORIGIN_REGEX=

# --- Auth / service token (staging-only secrets; never reuse production) ---
ADMIN_JWT_SECRET=change-me-to-a-long-random-staging-jwt-secret
ADMIN_JWT_EXPIRE_MINUTES=480
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-strong-staging-password
SERVICE_API_KEY=change-me-staging-service-api-key
SERVICE_API_KEY_PREVIOUS=
ALLOW_UNAUTHENTICATED_SERVICE_READS=false

RATE_LIMIT_ENABLED=true
GLOBAL_UPDATE_CRON_ENABLED=false

# --- Models mount (host path; optional) ---
MODELS_HOST_PATH=./backend/data/models
JOB_PREDICTION_MODEL_VERSION=v3

DATABASE_TARGET_URL=
SYNC_CLOUD=false

# --- Staging Telegram bot (dedicated BotFather token; never production token) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_API_BASE_URL=http://api:8000/api
TELEGRAM_SERVICE_API_KEY=change-me-staging-service-api-key
TELEGRAM_MODEL_VERSION=v3
TELEGRAM_MODEL_NAME=logistic_regression
TELEGRAM_MODEL_NAMES=logistic_regression,random_forest
TELEGRAM_DEFAULT_STAKE=10
TELEGRAM_SLIP_COUNT=9
TELEGRAM_MIN_EDGE_PERCENT=2.0

# --- API-Tennis (staging key or shared non-prod key; never commit real values) ---
API_TENNIS_KEY=your_staging_api_key_here
API_TENNIS_BASE=https://api.api-tennis.com/tennis/
API_TENNIS_TIMEOUT=30

# --- Live publication (keep off until staging validated) ---
LIVE_PUBLICATION_ENABLED=false
PUBLIC_MODEL_VERSION=
PUBLIC_MODEL_NAME=

# --- Observability (docs/MONITORING.md; staging-only secrets) ---
LOG_FORMAT=json
METRICS_PROVIDER=prometheus
METRICS_ENDPOINT_ENABLED=true
ERROR_TRACKING_PROVIDER=logging
ERROR_TRACKING_DSN=
ERROR_TRACKING_WEBHOOK_URL=
OPS_ALERTS_ENABLED=false
TELEGRAM_ADMIN_CHAT_ID=
OPS_ALERT_WEBHOOK_URL=
OPS_ALERT_COOLDOWN_SECONDS=300
OPS_IMPORT_MAX_AGE_HOURS=36
OPS_PREDICTIONS_LOOKBACK_HOURS=36
OPS_PIPELINE_MAX_DURATION_SECONDS=7200

# --- Optional TLS files for frontend nginx (HTTPS-ready; paths on host) ---
# Leave empty to serve HTTP on the published port (TLS at reverse proxy).
# STAGING_SSL_CERT=
# STAGING_SSL_KEY=
