#API TENNIS
API_TENNIS_KEY=your_api_key_here
API_TENNIS_BASE=https://api.api-tennis.com/tennis/
# Optional HTTP timeout in seconds for request_api (default 30)
API_TENNIS_TIMEOUT=30
METHODS=get_events,get_tournaments,get_livescore,get_fixtures,get_H2H,get_standings,get_standings,get_odds

# DB usato da import/cron locale
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tennis_db

# Migrazione / sync giornaliero locale -> cloud
DATABASE_SOURCE_URL=postgresql://postgres:postgres@localhost:5432/tennis_db
DATABASE_TARGET_URL=postgresql://postgres:postgres@<host-cloud>:5432/tennis_db
SYNC_CLOUD=true

# Global update cron (in-app scheduler, optional)
GLOBAL_UPDATE_CRON_ENABLED=false
GLOBAL_UPDATE_CRON_TIME=02:00
GLOBAL_UPDATE_CRON_TIMEZONE=Europe/Rome
GLOBAL_UPDATE_ALLOW_CONCURRENT_RUNS=false

# Admin authentication (dashboard + privileged API)
# Generate a long random secret for production; never commit real values.
ADMIN_JWT_SECRET=change-me-to-a-long-random-secret
ADMIN_JWT_EXPIRE_MINUTES=480
# Used only once at startup when admin_user table is empty (bootstrap).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-strong-password

# Separate bot/service protection (header X-Service-Token). Not an admin JWT.
# When set, bot-shared GET endpoints require this key (or a valid admin JWT).
# When empty and ALLOW_UNAUTHENTICATED_SERVICE_READS=true, those reads stay open (local default).
SERVICE_API_KEY=
ALLOW_UNAUTHENTICATED_SERVICE_READS=true
