# NOTE: i test backend (`pytest` dalla root) usano SQLite in-memory e secret di test;
# non leggono queste credenziali. Non inserire valori reali nel repository.
#
# Docker Compose: preferisci il file `.env` in root del repo (modello `.env.example`)
# e docs/DOCKER.md. In container locale DATABASE_URL usa spesso host.docker.internal;
# in staging (docs/STAGING.md) punta al servizio Compose `db`.

#API TENNIS
API_TENNIS_KEY=your_api_key_here
API_TENNIS_BASE=https://api.api-tennis.com/tennis/
# Optional HTTP timeout in seconds for request_api (default 30)
API_TENNIS_TIMEOUT=30
METHODS=get_events,get_tournaments,get_livescore,get_fixtures,get_H2H,get_standings,get_standings,get_odds

# DB usato da import/cron locale
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tennis_db

# Migrazione / sync giornaliero locale -> cloud
DATABASE_SOURCE_URL=postgresql://postgres:postgres@localhost:5432/tennis_db
DATABASE_TARGET_URL=postgresql://postgres:postgres@<host-cloud>:5432/tennis_db
SYNC_CLOUD=true

# Global update — production: prefer external cron/job
#   python -m backend.src.jobs.run_global_update
# In-app scheduler is optional (keep disabled in multi-replica prod).
GLOBAL_UPDATE_CRON_ENABLED=false
GLOBAL_UPDATE_CRON_TIME=02:00
GLOBAL_UPDATE_CRON_TIMEZONE=Europe/Rome
GLOBAL_UPDATE_ALLOW_CONCURRENT_RUNS=false
# Step reliability (API thread + CLI job share these)
GLOBAL_UPDATE_STEP_RETRIES=2
GLOBAL_UPDATE_RETRY_BACKOFF_SECONDS=5
GLOBAL_UPDATE_STEP_TIMEOUT_SECONDS=3600
GLOBAL_UPDATE_LOCK_TTL_SECONDS=21600


# Admin authentication (dashboard + privileged API)
# Generate a long random secret for production; never commit real values.
ADMIN_JWT_SECRET=change-me-to-a-long-random-secret
ADMIN_JWT_EXPIRE_MINUTES=480
# Used only once at startup when admin_user table is empty (bootstrap).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=1234

# Separate bot/service protection (header X-Service-Token). Not an admin JWT.
# When set, bot-shared GET endpoints require this key (or a valid admin JWT).
# When empty and ALLOW_UNAUTHENTICATED_SERVICE_READS=true, those reads stay open (local default).
# In staging/production set a long random SERVICE_API_KEY and mirror it on the bot.
SERVICE_API_KEY=
# Optional: keep the previous key accepted during rotation, then clear it.
SERVICE_API_KEY_PREVIOUS=
ALLOW_UNAUTHENTICATED_SERVICE_READS=true

# Rate limiting (PostgreSQL-backed; shared by API replicas and Telegram bot)
# Set RATE_LIMIT_ENABLED=false only for local debugging.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
# Unauthenticated requests: per client IP
RATE_LIMIT_PUBLIC=60
# Admin JWT requests: per token fingerprint
RATE_LIMIT_ADMIN=300
# Service token (bot→API): per token fingerprint
RATE_LIMIT_INTERNAL=600
# Extra quota for expensive endpoints (imports, global-update, SMVA, regenerate, …)
RATE_LIMIT_EXPENSIVE=20
# Stricter login anti-bruteforce per IP
RATE_LIMIT_LOGIN=10
# Telegram bot commands: per telegram_user_id
RATE_LIMIT_TELEGRAM=30
RATE_LIMIT_TELEGRAM_EXPENSIVE=10

# Telegram bot (optional). Same backend/.env or config.env; never commit real tokens.
TELEGRAM_BOT_TOKEN=
TELEGRAM_API_BASE_URL=http://localhost:8000/api
# Must match SERVICE_API_KEY when that is set (sent as X-Service-Token).
TELEGRAM_SERVICE_API_KEY=
TELEGRAM_MODEL_VERSION=v3
TELEGRAM_MODEL_NAME=logistic_regression
TELEGRAM_MODEL_NAMES=logistic_regression,random_forest
TELEGRAM_DEFAULT_STAKE=10
TELEGRAM_SLIP_COUNT=9
TELEGRAM_MIN_EDGE_PERCENT=2.0

# Live tip publication into PublishedPrediction (immutable ledger).
# Temporary until ML-07 official model registry. Default OFF = safe.
# When enabling: set BOTH PUBLIC_MODEL_VERSION and PUBLIC_MODEL_NAME explicitly.
# No silent fallback to another combination. Do not enable until migrations are applied
# and you have verified a dry global-update report.
LIVE_PUBLICATION_ENABLED=true
PUBLIC_MODEL_VERSION=v3
PUBLIC_MODEL_NAME=logistic_regression

# --- Observability (see docs/MONITORING.md) ---
# text | json (prefer json in production log aggregators)
LOG_FORMAT=text
# none | memory | prometheus
METRICS_PROVIDER=memory
METRICS_ENDPOINT_ENABLED=true
# none | logging | sentry | webhook  (sentry-sdk is optional, not in requirements.txt)
ERROR_TRACKING_PROVIDER=none
ERROR_TRACKING_DSN=
ERROR_TRACKING_WEBHOOK_URL=
# Admin alerts (fail-open). TELEGRAM_ADMIN_CHAT_ID = chat/channel id, not a token.
OPS_ALERTS_ENABLED=false
TELEGRAM_ADMIN_CHAT_ID=
OPS_ALERT_WEBHOOK_URL=
OPS_ALERT_COOLDOWN_SECONDS=300
OPS_IMPORT_MAX_AGE_HOURS=36
OPS_PREDICTIONS_LOOKBACK_HOURS=36
OPS_PIPELINE_MAX_DURATION_SECONDS=7200

# --- PostgreSQL backup / DR (docs/BACKUP_DR.md) ---
# Credentials: reuse DATABASE_URL above. Never put passwords in backup scripts.
BACKUP_DIR=backups
BACKUP_RETENTION_DAYS=7
BACKUP_ENCRYPT=false
BACKUP_GPG_RECIPIENT=
BACKUP_GPG_PASSPHRASE_FILE=

