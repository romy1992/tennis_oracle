# Configurazione runtime NON sensibile.
# Segreti (token/chiavi/password/URL con credenziali) in backend/.env.

# API TENNIS
API_TENNIS_BASE=https://api.api-tennis.com/tennis/
API_TENNIS_TIMEOUT=30
METHODS=get_events,get_tournaments,get_livescore,get_fixtures,get_H2H,get_standings,get_standings,get_odds

LIVE_PUBLICATION_ENABLED=true
# Fallback legacy, usato SOLO se il registro ML-07 (public_model_registry) non
# ha nessuna entry "active" (bootstrap/emergenza). In produzione il registro
# ha priorità: oggi è già attivo v4/voting_ensemble. Deve restare una
# combinazione ammessa da ACTIVE_MATCH_WINNER_VERSIONS (model_versioning.py),
# altrimenti resolve_public_model_config la rifiuta come "invalid".
PUBLIC_MODEL_VERSION=v4
PUBLIC_MODEL_NAME=voting_ensemble

SYNC_CLOUD=true
GLOBAL_UPDATE_CRON_ENABLED=false
GLOBAL_UPDATE_CRON_TIME=02:00
GLOBAL_UPDATE_CRON_TIMEZONE=Europe/Rome
GLOBAL_UPDATE_ALLOW_CONCURRENT_RUNS=false
GLOBAL_UPDATE_STEP_RETRIES=2
GLOBAL_UPDATE_RETRY_BACKOFF_SECONDS=5
GLOBAL_UPDATE_STEP_TIMEOUT_SECONDS=3600
GLOBAL_UPDATE_LOCK_TTL_SECONDS=21600

BETTING_SLIP_LIVE_POLL_ENABLED=true

ALLOW_UNAUTHENTICATED_SERVICE_READS=true

PAYMENTS_PROVIDER=stripe
PAYMENTS_MODE=sandbox
PAYMENTS_SUCCESS_URL=http://localhost:5173/payments/success
PAYMENTS_CANCEL_URL=http://localhost:5173/payments/cancel
PAYMENTS_IDEMPOTENCY_BUCKET_SECONDS=900
STRIPE_API_BASE=https://api.stripe.com/v1
STRIPE_REQUEST_TIMEOUT_SECONDS=20
STRIPE_PRICE_MONTHLY=price_change_me_monthly
STRIPE_PRICE_YEARLY=price_change_me_yearly
STRIPE_WEBHOOK_TOLERANCE_SECONDS=300

RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_PUBLIC=60
RATE_LIMIT_ADMIN=300
RATE_LIMIT_INTERNAL=600
RATE_LIMIT_EXPENSIVE=20
RATE_LIMIT_LOGIN=10
RATE_LIMIT_TELEGRAM=30
RATE_LIMIT_TELEGRAM_EXPENSIVE=10

TELEGRAM_WHITELIST_ENABLED=true
TELEGRAM_TERMS_REQUIRED=true
TELEGRAM_TERMS_VERSION=1
TELEGRAM_FEEDBACK_URL=
TELEGRAM_NOTIFY_PREDICTIONS_ENABLED=true
TELEGRAM_NOTIFY_RESULTS_ENABLED=true
TELEGRAM_NOTIFY_EMPTY_DAY_ENABLED=true
TELEGRAM_NOTIFY_MIN_INTERVAL_SECONDS=0.05
TELEGRAM_NOTIFY_MAX_RETRIES=2
TELEGRAM_NOTIFY_RETRY_BACKOFF_SECONDS=2.0
WEEKLY_BETA_REPORT_TELEGRAM_ENABLED=true

WALK_FORWARD_IN_GLOBAL_UPDATE=false
WALK_FORWARD_MODE=expanding
WALK_FORWARD_INITIAL_TRAIN_DAYS=365
WALK_FORWARD_TEST_DAYS=90
WALK_FORWARD_STEP_DAYS=90
WALK_FORWARD_MIN_TRAIN_ROWS=200
WALK_FORWARD_MIN_TEST_ROWS=50
WALK_FORWARD_EMBARGO_DAYS=0
WALK_FORWARD_EDGE_THRESHOLD=0.03
WALK_FORWARD_RANDOM_STATE=42

CALIBRATION_N_BINS=10
CALIBRATION_MIN_BIN_SAMPLES=30
CALIBRATION_MIN_CALIBRATOR_TRAIN_SAMPLES=100

# Closing odds pre-kickoff capture (job run_closing_odds_capture; opt-in, vedi
# docs/SCHEDULING.md#closing-odds-pre-kickoff-job). Abilita solo insieme a un
# cron/Task Scheduler frequente (ogni 1-5 minuti).
CLOSING_ODDS_JOB_ENABLED=false
CLOSING_ODDS_CAPTURE_WINDOW_MINUTES=60

LOG_FORMAT=text
METRICS_PROVIDER=memory
METRICS_ENDPOINT_ENABLED=true
ERROR_TRACKING_PROVIDER=none

OPS_ALERTS_ENABLED=false
TELEGRAM_ADMIN_CHAT_ID=
OPS_ALERT_COOLDOWN_SECONDS=300
OPS_IMPORT_MAX_AGE_HOURS=36
OPS_PREDICTIONS_LOOKBACK_HOURS=36
OPS_PIPELINE_MAX_DURATION_SECONDS=7200

BACKUP_DIR=backups
BACKUP_RETENTION_DAYS=7
BACKUP_ENCRYPT=false
BACKUP_GPG_RECIPIENT=
BACKUP_GPG_PASSPHRASE_FILE=
