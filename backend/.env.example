# Primary backend runtime env (secrets + service overrides).
# Copy to backend/.env and keep real values out of git.

APP_ENV=local
DEBUG=false
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tennis_db
DATABASE_SOURCE_URL=postgresql://postgres:postgres@localhost:5432/tennis_db
DATABASE_TARGET_URL=
CORS_ORIGINS=["http://localhost:5173","http://localhost:5174","http://127.0.0.1:5173","http://127.0.0.1:5174"]
CORS_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1):\d+$

# Admin authentication
ADMIN_JWT_SECRET=change-me-to-a-long-random-secret
ADMIN_JWT_EXPIRE_MINUTES=480
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-strong-password

# API keys and integration secrets
API_TENNIS_KEY=your_api_tennis_key
# One stable Fernet key per environment; generate with the command in README.
RUNTIME_SECRETS_MASTER_KEY=
SERVICE_API_KEY=
SERVICE_API_KEY_PREVIOUS=
TELEGRAM_SERVICE_API_KEY=
STRIPE_SECRET_KEY=sk_test_change_me
STRIPE_WEBHOOK_SECRET=whsec_change_me
PAYMENTS_PROVIDER=stripe
PAYMENTS_MODE=sandbox
PAYMENTS_SUCCESS_URL=http://localhost:5173/payments/success
PAYMENTS_CANCEL_URL=http://localhost:5173/payments/cancel
PAYMENTS_PORTAL_RETURN_URL=http://localhost:5173/account
PAYMENTS_PORTAL_LINK_TTL_SECONDS=1800
STRIPE_PRICE_MONTHLY=price_change_me_monthly
STRIPE_PRICE_YEARLY=price_change_me_yearly
ERROR_TRACKING_DSN=
ERROR_TRACKING_WEBHOOK_URL=
OPS_ALERT_WEBHOOK_URL=

# Scheduled report email secret. Prefer the deployment secret store in dev/prod.
RESEND_API_KEY=

# Telegram bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_API_BASE_URL=http://localhost:8000/api
TELEGRAM_MODEL_VERSION=v3
TELEGRAM_MODEL_NAME=logistic_regression
TELEGRAM_MODEL_NAMES=logistic_regression,random_forest
TELEGRAM_DEFAULT_STAKE=10
TELEGRAM_SLIP_COUNT=9
TELEGRAM_MIN_EDGE_PERCENT=2.0
TELEGRAM_PREMIUM_UPGRADE_URL=
TELEGRAM_NOTIFICATIONS_ENABLED=true


